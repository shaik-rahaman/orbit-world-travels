// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  ADMIN
  STAFF
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum VisaStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ModuleType {
  VISA
  FLIGHT
  HOTEL
  INSURANCE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ==================== USERS ====================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices    Invoice[]
  visas       Visa[]
  flights     Flight[]
  hotels      Hotel[]
  insurances  Insurance[]
  clients     Client[]

  @@index([email])
  @@index([role])
}

// ==================== CLIENTS ====================

model Client {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  address     String?
  country     String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices  Invoice[]
  visas     Visa[]
  flights   Flight[]
  hotels    Hotel[]
  insurance Insurance[]

  @@index([email])
  @@index([createdById])
}

// ==================== INVOICES ====================

model Invoice {
  id                String         @id @default(cuid())
  invoiceNumber     String         @unique
  financialYear     Int
  status            InvoiceStatus  @default(DRAFT)
  totalVendorCost   Decimal        @default(0) @db.Decimal(12, 2)
  totalCustomerAmount Decimal      @default(0) @db.Decimal(12, 2)
  totalMargin       Decimal        @default(0) @db.Decimal(12, 2)
  notes             String?
  createdById       String
  createdBy         User           @relation(fields: [createdById], references: [id])
  clientId          String?
  client            Client?        @relation(fields: [clientId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  invoiceItems InvoiceItem[]

  @@unique([financialYear, invoiceNumber])
  @@index([status])
  @@index([financialYear])
  @@index([createdById])
  @@index([clientId])
}

model InvoiceItem {
  id                String   @id @default(cuid())
  invoiceId         String
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  moduleType        ModuleType
  referenceId       String   // ID of visa/flight/hotel/insurance record
  vendorCost        Decimal  @db.Decimal(12, 2)
  customerAmount    Decimal  @db.Decimal(12, 2)
  margin            Decimal  @db.Decimal(12, 2)
  description       String?
  createdAt         DateTime @default(now())

  @@index([invoiceId])
  @@index([moduleType])
  @@index([referenceId])
}

// ==================== VISA ====================

model Visa {
  id              String     @id @default(cuid())
  applicantName   String
  country         String
  visaType        String
  status          VisaStatus @default(PENDING)
  vendorCost      Decimal    @db.Decimal(12, 2)
  customerAmount  Decimal    @db.Decimal(12, 2)
  margin          Decimal    @db.Decimal(12, 2)
  documents       String?    // JSON array of document URLs
  notes           String?
  createdById     String
  createdBy       User       @relation(fields: [createdById], references: [id])
  clientId        String?
  client          Client?    @relation(fields: [clientId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([country])
  @@index([createdById])
  @@index([clientId])
}

// ==================== FLIGHT ====================

model Flight {
  id              String   @id @default(cuid())
  airline         String
  flightNumber    String
  pnr             String   @unique
  sector          String
  passengerName   String
  ticketUrl       String?
  vendorCost      Decimal  @db.Decimal(12, 2)
  customerAmount  Decimal  @db.Decimal(12, 2)
  margin          Decimal  @db.Decimal(12, 2)
  departureDate   DateTime?
  returnDate      DateTime?
  notes           String?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([pnr])
  @@index([passengerName])
  @@index([createdById])
  @@index([clientId])
}

// ==================== HOTEL ====================

model Hotel {
  id              String   @id @default(cuid())
  hotelName       String
  city            String
  checkInDate     DateTime
  checkOutDate    DateTime
  roomType        String
  guestName       String
  vendorCost      Decimal  @db.Decimal(12, 2)
  customerAmount  Decimal  @db.Decimal(12, 2)
  margin          Decimal  @db.Decimal(12, 2)
  bookingReference String?
  notes           String?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([city])
  @@index([checkInDate])
  @@index([createdById])
  @@index([clientId])
}

// ==================== INSURANCE ====================

model Insurance {
  id              String   @id @default(cuid())
  policyNumber    String   @unique
  insuredName     String
  policyType      String
  coverageAmount  Decimal  @db.Decimal(12, 2)
  vendorCost      Decimal  @db.Decimal(12, 2)
  customerAmount  Decimal  @db.Decimal(12, 2)
  margin          Decimal  @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime
  notes           String?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([policyNumber])
  @@index([insuredName])
  @@index([createdById])
  @@index([clientId])
}
