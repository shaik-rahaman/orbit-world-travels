# PRODUCTION ENVIRONMENT - Backend
# ⚠️ NEVER commit this file to version control

NODE_ENV=production
PORT=3008

# Database - Use MongoDB Atlas or cloud provider
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/orbit_world_db?retryWrites=true&w=majority
DB_NAME=orbit_world_db
COLLECTION_NAME=travel_data
VECTOR_INDEX_NAME=vector_index
BM25_INDEX_NAME=vector_index_bm25

# JWT - Generate a strong random string for production
JWT_SECRET=your_strong_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRATION=24h

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# AWS S3 (if using S3 for file storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_production_s3_bucket

# PDF Configuration
PDF_MARGIN_TOP=20
PDF_MARGIN_BOTTOM=20
PDF_MARGIN_LEFT=20
PDF_MARGIN_RIGHT=20

# Logging
LOG_LEVEL=warn

# AI - Groq LLM
GROQ_API_KEY=your_production_groq_api_key
GROQ_MODEL=llama-3-70b-versatile

# CORS - Set to your production domain
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
