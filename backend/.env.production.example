# PRODUCTION ENVIRONMENT CONFIGURATION
# ⚠️ IMPORTANT: Copy this file to .env.production and update all values for your production environment
# 🔒 NEVER commit actual .env.production with real credentials to version control

# Server Configuration
NODE_ENV=production
PORT=3008

# Database Configuration
# ⚠️ CRITICAL: Use your actual MongoDB Atlas connection string from MongoDB dashboard
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
# Steps:
# 1. Go to MongoDB Atlas dashboard
# 2. Click "Connect" on your cluster
# 3. Choose "Connect your application"
# 4. Copy the connection string
# 5. Replace username, password, and database name as needed
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/orbit_world_db
DB_NAME=orbit_world_db
COLLECTION_NAME=travel_data
VECTOR_INDEX_NAME=vector_index
BM25_INDEX_NAME=vector_index_bm25

# CORS Configuration
# Update with your production frontend domain
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# JWT Configuration
# ⚠️ CRITICAL: Generate a strong, unique secret key for production
# Recommendation: Use `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=your-production-jwt-secret-key-min-32-chars
JWT_EXPIRATION=24h

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# AWS S3 Configuration (if using S3 for file storage)
# Get credentials from AWS IAM console
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-production-access-key
AWS_SECRET_ACCESS_KEY=your-production-secret-key
AWS_S3_BUCKET=orbit-world-production-bucket

# PDF Generation Configuration
PDF_MARGIN_TOP=20
PDF_MARGIN_BOTTOM=20
PDF_MARGIN_LEFT=20
PDF_MARGIN_RIGHT=20

# Logging Configuration
LOG_LEVEL=warn

# Groq AI Configuration
# Get API key from https://console.groq.com
GROQ_API_KEY=your-production-groq-api-key
GROQ_MODEL=llama-3-70b-versatile

# Optional: New Relic or other monitoring
# NEW_RELIC_APP_NAME=Orbit World API
# NEW_RELIC_LICENSE_KEY=your-license-key
